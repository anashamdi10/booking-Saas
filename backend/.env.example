APP_NAME="منصة حجوزات المصورين"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
FRONTEND_URL=http://localhost:5173

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=photographers
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Front-end (Vue SPA)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_SUPPORTS_CREDENTIALS=false
SANCTUM_EXPIRATION=10080
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Media storage (Cloudflare R2 / AWS S3)
# ---------------------------------------------------------------------------
# "public_disk"  → logos, covers, portfolio samples (public CDN)
# "private_disk" → client galleries, served through signed URLs only
MEDIA_PUBLIC_DISK=local
MEDIA_PRIVATE_DISK=local
MEDIA_MAX_UPLOAD_KB=20480

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_REGION=auto
MEDIA_BUCKET=
MEDIA_ENDPOINT=
MEDIA_URL=
MEDIA_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
